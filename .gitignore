# colcon / ROS
build/
install/
log/
src/*/build/
src/*/install/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/

# Frontend (rosy_web 예정)
node_modules/
dist/

# rosy_games 실기 URL/토큰
src/rosy_games/config/match.local.yaml

# Fleet 로컬 DB
*.sqlite3
*.db

# IDE / OS
.vscode/
.idea/
.DS_Store/

# 대형 바이너리 참조 (upstream 원본 zip — 리포에 반입하지 않음)
reference/src/*.zip

# 도구 캐시
.codegraph/
.omo/

# OMC 운영 산출물 (.omc/skills 제외)
.omc/
!.omc/skills/

# rosy_control 테스트 basetemp (Windows 호스트에서 --basetemp 로 지정)
.pytest-tmp-control/

# rosy_games local match override (device URLs / tokens)
src/rosy_games/config/match.local.yaml
