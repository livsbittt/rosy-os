<?xml version='1.0' ?>

<!-- P0-4 (A-3/A-4): namespace 플러밍 — 로봇별 토픽/TF 분리 (ROSY-CORE-SRS-001 §6)
     사용 예:
       ros2 launch rosy_bringup bringup_robot.launch.xml
       ros2 launch rosy_bringup bringup_robot.launch.xml namespace:=rosy_01 -->

<launch>
    <arg name="namespace" default=""/>
    <arg name="use_sim_time" default="False"/>
    <arg name="wheel_radius" default="0.027"/>
    <arg name="wheel_separation" default="0.0961"/>

    <let name="frame_prefix" value="$(eval namespace + '/' if namespace else '')"/>
    <let name="lidar_frame" value="$(eval namespace + '/rplidar_link' if namespace else 'rplidar_link')"/>

    <include file="$(find-pkg-share rosy_description)/launch/upload_robot.launch.py">
        <arg name="namespace" value="$(var namespace)"/>
        <arg name="is_sim" value="$(var use_sim_time)"/>
    </include>

    <group>
        <push-ros-namespace namespace="$(var namespace)"/>

        <include file="$(find-pkg-share sllidar_ros2)/launch/sllidar_c1_launch.py">
            <arg name="serial_port" value="/dev/ttyAMA0"/>
            <arg name="frame_id" value="$(var lidar_frame)"/>
            <arg name="inverted" value="false"/>
            <arg name="angle_compensate" value="true"/>
            <arg name="scan_mode" value="DenseBoost"/>
        </include>

        <node pkg="rosy_bringup" exec="bringup">
            <param from="$(find-pkg-share rosy_bringup)/config/rosy_params.yaml"/>
            <param name="wheel_radius" value="$(var wheel_radius)"/>
            <param name="wheel_separation" value="$(var wheel_separation)"/>
            <param name="frame_prefix" value="$(var frame_prefix)"/>
        </node>

        <node pkg="rosy_bringup" exec="battery_publisher">
        </node>
    </group>

</launch>
