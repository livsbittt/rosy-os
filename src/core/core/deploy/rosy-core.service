[Unit]
Description=ROSY CORE robot middleware
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rosy
ExecStart=/bin/bash -lc 'source /opt/ros/jazzy/setup.bash && source /home/rosy/rosy_ws/install/setup.bash && ros2 run rosy_core rosy_core'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
